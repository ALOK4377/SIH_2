# Samanvay environment — copy to `.env` and adjust. All backend settings use the
# SAMANVAY_ prefix. With none set, the backend runs on a local SQLite file.

# --- Database -------------------------------------------------------------
# Left unset here on purpose: the backend then defaults to a local SQLite file
# (backend/samanvay.db) — so `seed_db.py` and `uvicorn` work with no database.
# docker-compose injects the Postgres URL into the backend container itself
# (see its `environment:` block), so you do NOT need to set it here for Docker.
# To force Postgres for a LOCAL (non-Docker) run, uncomment and point at your DB:
# SAMANVAY_DATABASE_URL=postgresql+psycopg://samanvay:samanvay@localhost:5432/samanvay

# --- CORS (comma-separated origins allowed to call the API) ---------------
SAMANVAY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Pipeline operating point --------------------------------------------
SAMANVAY_AUTO_THRESHOLD=0.70
SAMANVAY_REVIEW_LOW=0.50

# --- Postgres container credentials (used by the db service) --------------
POSTGRES_USER=samanvay
POSTGRES_PASSWORD=samanvay
POSTGRES_DB=samanvay

# --- Frontend → backend base URL (baked into the Vite build) --------------
VITE_API_BASE=http://localhost:8000/api
